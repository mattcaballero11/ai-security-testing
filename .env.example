# Copy to .env and adjust. .env is gitignored and must never be committed.

# Control set. baseline = deliberately weak, hardened = layered controls.
APP_MODE=baseline

# Bind address. Do not change the host. The target is localhost only, by design.
APP_HOST=127.0.0.1
APP_PORT=8000

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Pin the tag including the quantization. Record the digest in every evidence file.
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# Optional: fail startup unless the running model reports this digest.
# Get it from: ollama list  (or: ollama show --modelfile llama3.2:3b-instruct-q4_K_M)
OLLAMA_MODEL_DIGEST=

# Generation options (section 3 of the build spec).
# The canonical run uses these values. Rate runs override temperature and seed
# per request (temperature 0.7, seed unset) via the /chat request body.
GEN_TEMPERATURE=0.0
GEN_SEED=42
GEN_TOP_P=1.0
GEN_NUM_CTX=4096
GEN_NUM_PREDICT=512

# Request timeout to Ollama, seconds. Raise this on a slow VM.
OLLAMA_TIMEOUT=120

# Hardened-mode input cap, characters. Ignored in baseline.
MAX_INPUT_CHARS=6000

# Hardened-mode rate limit on /chat, requests per window per client host.
# Ignored in baseline.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Structured JSON request/response logs. Directory is gitignored.
LOG_DIR=logs
