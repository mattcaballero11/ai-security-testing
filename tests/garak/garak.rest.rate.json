{
  "rest": {
    "RestGenerator": {
      "name": "docsummarizer-chat-rate",
      "uri": "http://127.0.0.1:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT",
        "is_summary_request": false,
        "use_history": false,
        "rate_run": true
      },
      "response_json": true,
      "response_json_field": "content",
      "request_timeout": 180,
      "ratelimit_codes": [429]
    }
  }
}
